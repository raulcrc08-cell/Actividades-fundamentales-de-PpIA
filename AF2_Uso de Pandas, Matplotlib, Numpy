        "id": "Hf5Z_eAG08A6"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# 1. Scatter Plot\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "#2. Codificacion de colores\n",
        "colores = {'Adelie': 'orange', 'Chinstrap': 'purple', 'Gentoo': 'blue'}\n",
        "\n",
        "# Puntos por cada especie\n",
        "for especie, grupo in df.dropna(subset=['flipper_length_mm', 'body_mass_g']).groupby('species'):\n",
        "    plt.scatter(grupo['flipper_length_mm'], grupo['body_mass_g'],\n",
        "                color=colores[especie], label=especie, alpha=0.7, edgecolors='k')\n",
        "\n",
        "# 3. Anotaciones\n",
        "pinguino_mas_pesado = df.loc[df['body_mass_g'].idxmax()]\n",
        "px = pinguino_mas_pesado['flipper_length_mm']\n",
        "py = pinguino_mas_pesado['body_mass_g']\n",
        "nombre_especie = pinguino_mas_pesado['species']\n",
        "\n",
        "plt.annotate(f\"El más pesado ({py}g, {nombre_especie})\",\n",
        "             xy=(px, py),\n",
        "             xytext=(px - 25, py - 400),\n",
        "             arrowprops=dict(facecolor='black', shrink=0.08, width=1, headwidth=8),\n",
        "             fontsize=10,\n",
        "             fontweight='bold')\n",
        "# Impresión de gráfica\n",
        "plt.title('Relación entre Largo de Aleta y Masa Corporal', fontsize=14)\n",
        "plt.xlabel('Largo de la Aleta (mm)', fontsize=12)\n",
        "plt.ylabel('Masa Corporal (g)', fontsize=12)\n",
        "plt.legend(title='Especie')\n",
        "plt.grid(True, linestyle='--', alpha=0.5)\n",
