        "def evaluar_modelo():\n",
        "    try:\n",
        "        entrada = input(\"Ingresa la exactitud del modelo (un número entre 0.0 y 1.0): \")\n",
        "        exactitud = float(entrada)\n",
        "\n",
        "        if exactitud < 0.0 or exactitud > 1.0:\n",
        "            print(\"Error: El valor ingresado debe estar estrictamente entre 0.0 y 1.0.\")\n",
        "            return\n",
        "\n",
        "        if exactitud >= 0.90:\n",
        "            categoria = \"Excelente\"\n",
        "        elif exactitud >= 0.75:\n",
        "            categoria = \"Aceptable\"\n",
        "        elif exactitud >= 0.50:\n",
        "            categoria = \"Requiere Ajuste\"\n",
        "        else:\n",
        "            categoria = \"Crítico / No apto\"\n",
        "\n",
        "        print(f\"\\nExactitud registrada: {exactitud}\")\n",
        "        print(f\"Categoría del modelo: {categoria}\")\n",
        "\n",
        "        return categoria\n",
        "\n",
        "    except ValueError:\n",
        "        print(\"Error: Por favor, introduce un valor numérico válido (ej. 0.85).\")\n",
        "\n",
        "evaluar_modelo()"
      ]
