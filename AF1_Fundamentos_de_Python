        "def simular_entrenamiento():\n",
        "    max_epocas = int(input(\"Ingresa el número máximo de épocas a simular: \"))\n",
        "\n",
        "    umbral = 0.05          # Tolerancia para el criterio de parada\n",
        "    perdida = 1.0          # Pérdida inicial\n",
        "    convergio = False\n",
        "\n",
        "    for epoca in range(1, max_epocas + 1):\n",
        "        perdida = 1.0 / (epoca ** 1.5)\n",
        "\n",
        "        print(f\"Época {epoca}/{max_epocas} - Pérdida: {perdida:.4f}\")\n",
        "\n",
        "        if perdida < umbral:\n",
        "            print(f\"\\nEl modelo convergió anticipadamente en la época {epoca} (pérdida < {umbral}).\")\n",
        "            convergio = True\n",
        "            break\n",
        "\n",
        "    if not convergio:\n",
        "        print(f\"\\nEl entrenamiento terminó las {max_epocas} épocas sin alcanzar el umbral de {umbral}.\")\n",
        "\n",
        "    return perdida\n",
        "\n",
        "\n",
        "simular_entrenamiento()\n"
      ]
