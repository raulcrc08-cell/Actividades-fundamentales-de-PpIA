        "CONFIGURACION_BASE = (512, 10)\n",
        "\n",
        "def procesar_tasas_aprendizaje(tasas_lr):\n",
        "    \"\"\"\n",
        "    Recibe una lista de tasas de aprendizaje, las escala mediante un operador\n",
